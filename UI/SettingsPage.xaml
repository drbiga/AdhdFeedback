<Page x:Class="UI.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UI"
      xmlns:core="clr-namespace:Core.Models;assembly=Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">

    <Grid>
        <Label Content="Environment" HorizontalAlignment="Left" Margin="70,114,0,0" VerticalAlignment="Top"/>
        <ComboBox
            x:Name="EnvironmentComboBox"
            HorizontalAlignment="Left"
            Margin="172,118,0,0"
            VerticalAlignment="Top"
            Width="120"
            ItemsSource="{Binding EnvironmentOptionsDisplayNameList}"
            SelectedItem="{Binding Source={x:Static core:Settings.Current}, 
                                         Path=Environment, 
                                         Mode=TwoWay}"
        />
        <Rectangle
            HorizontalAlignment="Center"
            Height="74"
            Margin="0,1,0,0"
            Stroke="#333"
            Fill="#333"
            VerticalAlignment="Top"
            Width="800"/>
        <TextBlock
            HorizontalAlignment="Left"
            Margin="70,23,0,0"
            TextWrapping="Wrap"
            Text="Settings"
            FontSize="24"
            Foreground="White"
            VerticalAlignment="Top"/>
    </Grid>
</Page>
