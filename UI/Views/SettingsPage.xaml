<Page x:Class="UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UI"
      xmlns:vm="clr-namespace:UI.ViewModels"
      xmlns:core="clr-namespace:Core.Models;assembly=Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">

    <Page.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="Azure" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,10,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,10,10" />
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="5,0,5,0" />
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <!-- The Track -->
                        <Border x:Name="Border" 
                        Width="40" Height="20" 
                        CornerRadius="10" 
                        Background="#D1D5DB" 
                        Cursor="Hand">
                            <!-- The Thumb (Circle) -->
                            <Ellipse x:Name="Thumb" 
                             Width="16" Height="16" 
                             Fill="White" 
                             HorizontalAlignment="Left" 
                             Margin="2">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#3B82F6" Duration="0:0:0.1" />
                                            <ThicknessAnimation Storyboard.TargetName="Thumb" 
                                            Storyboard.TargetProperty="Margin"
                                            To="22,2,2,2" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Border" 
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#D1D5DB" Duration="0:0:0.1" />
                                            <ThicknessAnimation Storyboard.TargetName="Thumb" 
                                            Storyboard.TargetProperty="Margin"
                                            To="2" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <DockPanel>
        <Border
            Background="#222"
            Padding="50,5,0,5"
            DockPanel.Dock="Top"
        >
            <TextBlock
                HorizontalAlignment="Left"
                TextWrapping="Wrap"
                FontSize="24"
                Foreground="White"
                VerticalAlignment="Top"
               >
                Settings
            </TextBlock>
        </Border>
        <Border Padding="50,0,50,0" Background="#111">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0" Grid.Column="0"
                        FontSize="22"
                        FontWeight="Bold"
                    >
                        Environment
                    </Label>

                    <ComboBox
                        x:Name="EnvironmentComboBox"
                        Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        MinWidth="100"
                        ItemsSource="{Binding EnvironmentOptionsDisplayNameList}"
                        SelectedItem="{Binding Settings.Environment}"
                    />

                    <!--==========================-->
                    <!-- BACKEND PROTOCOL -->
                    <Label
                        Grid.Row="1" Grid.Column="0"
                    >
                        Backend Protocol:
                    </Label>
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        x:Name="backendProtocolText"
                        Text="{Binding Settings.ServerParams.BackendProtocol}"
                    />

                    <!--==========================-->
                    <!-- BACKEND HOST -->
                    <Label
                        Grid.Row="2" Grid.Column="0"
                    >
                        Backend Host:
                    </Label>
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        x:Name="backendHostText"
                        Text="{Binding Settings.ServerParams.BackendHost}"
                        TextWrapping="Wrap"
                    />

                    <!--==========================-->
                    <!-- BACKEND PORT -->
                    <Label
                        Grid.Row="3" Grid.Column="0"
                    >
                        Backend Port:
                    </Label>
                    <TextBlock
                        Grid.Row="3" Grid.Column="1"
                        x:Name="backendPortText"
                        Text="{Binding Settings.ServerParams.BackendPort}"
                    />
                    <!--==========================-->
                    <!-- BACKEND PREFIX -->
                    <Label
                        Grid.Row="4" Grid.Column="0"
                    >
                        Backend Prefix:
                    </Label>
                    <TextBlock
                        Grid.Row="4" Grid.Column="1"
                        x:Name="backendPrefixText"
                        Text="{Binding Settings.ServerParams.BackendPrefix}"
                    />
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0">Use Real SessionExecutionService</Label>
                    <CheckBox
                        Grid.Row="0" Grid.Column="1"
                        Style="{DynamicResource ToggleSwitchStyle}"
                        IsChecked="{Binding UseRealSessionExecutionService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                    <Label Grid.Row="1" Grid.Column="0">Use Mock SessionExecutionService</Label>
                    <CheckBox
                        Grid.Row="1" Grid.Column="1"
                        Style="{DynamicResource ToggleSwitchStyle}"
                        IsChecked="{Binding UseMockSessionExecutionService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Page>
